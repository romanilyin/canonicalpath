{
  "version": 1,
  "cases": [
    {
      "id": "equal-posix-normalized",
      "operation": "is-equal",
      "root": "/home//alice/./repo",
      "target": "/home/alice/repo",
      "options": {
        "sourceHost": "posix",
        "targetProfile": "posix"
      },
      "expected": "true"
    },
    {
      "id": "unequal-posix-prefix-sibling",
      "operation": "is-equal",
      "root": "/tmp/project",
      "target": "/tmp/project-evil",
      "options": {
        "sourceHost": "posix",
        "targetProfile": "posix"
      },
      "expected": "false"
    },
    {
      "id": "equal-win-drive-separators",
      "operation": "is-equal",
      "root": "C:\\Users\\Alice\\Repo",
      "target": "c:/Users/Alice/Repo",
      "options": {
        "sourceHost": "win32",
        "targetProfile": "win32-drive"
      },
      "expected": "true"
    },
    {
      "id": "unequal-win-case-preserved",
      "operation": "is-equal",
      "root": "C:\\Users\\Alice\\Repo",
      "target": "c:/users/Alice/Repo",
      "options": {
        "sourceHost": "win32",
        "targetProfile": "win32-drive"
      },
      "expected": "false"
    },
    {
      "id": "equal-wsl-to-win-drive",
      "operation": "is-equal",
      "root": "/mnt/c/Users/Alice/Repo",
      "target": "c:/Users/Alice/Repo",
      "options": {
        "sourceHost": "wsl",
        "targetProfile": "win32-drive",
        "wsl": {
          "enabled": true,
          "mountRoot": "/mnt"
        }
      },
      "expected": "true"
    },
    {
      "id": "is-equal-empty-left-rejected",
      "operation": "is-equal",
      "root": "",
      "target": "/tmp/repo",
      "options": {
        "sourceHost": "posix",
        "targetProfile": "posix"
      },
      "error": "ERR_EMPTY_PATH"
    },
    {
      "id": "unequal-unicode-nfc-nfd",
      "operation": "is-equal",
      "root": "/repo/café",
      "target": "/repo/café",
      "expected": "false"
    },
    {
      "id": "unequal-unicode-nfd-nfc",
      "operation": "is-equal",
      "root": "/repo/café",
      "target": "/repo/café",
      "expected": "false"
    },
    {
      "id": "equal-unicode-identical-nfd",
      "operation": "is-equal",
      "root": "/repo/café",
      "target": "/repo/café",
      "expected": "true"
    },
    {
      "id": "unequal-unicode-unc-server",
      "operation": "is-equal",
      "root": "//café/share/repo",
      "target": "//café/share/repo",
      "expected": "false"
    },
    {
      "id": "unequal-wsl-cross-drive-alias",
      "operation": "is-equal",
      "root": "/mnt/c/../d/repo",
      "target": "/mnt/c/d/repo",
      "options": {
        "wsl": {
          "enabled": true
        }
      },
      "expected": "false"
    },
    {
      "id": "equal-wsl-cleaned-drive",
      "operation": "is-equal",
      "root": "/mnt/c/../d/repo",
      "target": "d:/repo",
      "options": {
        "wsl": {
          "enabled": true
        }
      },
      "expected": "true"
    },
    {
      "id": "cp1-native-backslash-distinct-from-slash",
      "operation": "is-equal",
      "root": "/repo/a\\b",
      "target": "/repo/a/b",
      "options": {
        "sourceHost": "posix"
      },
      "expected": "false"
    },
    {
      "id": "cp1-canonical-backslash-distinct-from-slash",
      "operation": "is-equal",
      "root": "/repo/a\\b",
      "target": "/repo/a/b",
      "options": {
        "sourceHost": "canonical"
      },
      "expected": "false"
    },
    {
      "id": "cp1-native-drive-component-case-preserved",
      "operation": "is-equal",
      "root": "/C:/repo",
      "target": "/c:/repo",
      "options": {
        "sourceHost": "posix"
      },
      "expected": "false"
    },
    {
      "id": "cp1-canonical-posix-drive-distinct",
      "operation": "is-equal",
      "root": "/c:/repo",
      "target": "c:/repo",
      "options": {
        "sourceHost": "canonical"
      },
      "expected": "false"
    },
    {
      "id": "cp1-canonical-relative-drive-distinct",
      "operation": "is-equal",
      "root": "./c:/repo",
      "target": "c:/repo",
      "options": {
        "sourceHost": "canonical"
      },
      "expected": "false"
    },
    {
      "id": "cp1-native-marked-and-unmarked-relative",
      "operation": "is-equal",
      "root": "C:foo",
      "target": "./C:foo",
      "options": {
        "sourceHost": "posix"
      },
      "expected": "true"
    },
    {
      "id": "cp1-canonical-literal-percent-distinct",
      "operation": "is-equal",
      "root": "/repo/a%2Fb",
      "target": "/repo/a/b",
      "options": {
        "sourceHost": "canonical"
      },
      "expected": "false"
    },
    {
      "id": "cp2-canonical-preserved-drive-distinct",
      "operation": "is-equal",
      "root": "//?/c:/repo",
      "target": "c:/repo",
      "options": {
        "sourceHost": "canonical"
      },
      "expected": "false"
    },
    {
      "id": "cp2-raw-extended-prefix-explicitly-unwrapped",
      "operation": "is-equal",
      "root": "//?/C:/repo",
      "target": "c:/repo",
      "options": {},
      "expected": "true"
    },
    {
      "id": "cp2-preserved-drive-same-spelling",
      "operation": "is-equal",
      "root": "\\\\?\\C:\\repo",
      "target": "//?/c:/repo",
      "options": {
        "windows": {
          "preserveExtendedLength": true
        }
      },
      "expected": "true"
    }
  ]
}
