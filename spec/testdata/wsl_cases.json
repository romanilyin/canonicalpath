        "sourceHost": "wsl",
        "targetProfile": "portable",
        "wsl": {
          "enabled": true,
          "mountRoot": "/mnt"
        }
      },
      "expected": "/mnt-evil/d/repo"
    },
    {
      "id": "wsl-identity-drive-prefix-sibling",
      "operation": "normalize",
      "raw": "/mnt/cd/../c/repo",
      "options": {
        "sourceHost": "wsl",
        "targetProfile": "portable",
        "wsl": {
          "enabled": true,
          "mountRoot": "/mnt"
        }
      },
      "expected": "c:/repo"
