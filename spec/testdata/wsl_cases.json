      "options": {
        "sourceHost": "wsl",
        "targetProfile": "portable",
        "wsl": {
          "enabled": true,
          "mountRoot": "/mnt"
        }
      },
      "expected": "d:/repo"
    },
    {
      "id": "wsl-identity-distinct-nested",
      "operation": "normalize",
      "raw": "/mnt/c/d/repo",
      "options": {
        "sourceHost": "wsl",
        "targetProfile": "portable",
        "wsl": {
          "enabled": true,
          "mountRoot": "/mnt"
        }
      },
      "expected": "c:/d/repo"
    },
    {
      "id": "wsl-identity-leave-mount",
      "operation": "normalize",
      "raw": "/mnt/c/../../repo",
      "options": {
        "sourceHost": "wsl",
        "targetProfile": "portable",
        "wsl": {
          "enabled": true,
          "mountRoot": "/mnt"
        }
      },
      "expected": "/repo"
