      "operation": "normalize",
      "raw": "file:///C:/../repo",
      "options": {
        "sourceHost": "wsl",
        "targetProfile": "portable",
        "wsl": {
          "enabled": true,
          "mountRoot": "/mnt"
        },
        "uri": {
          "allowFileUri": true
        }
      },
      "expected": "c:/repo"
    },
    {
      "id": "wsl-identity-unicode-mount-exact",
      "operation": "normalize",
      "raw": "/café/c/repo",
      "options": {
        "sourceHost": "wsl",
