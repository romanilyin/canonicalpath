    {
      "id": "wsl-identity-non-drive-component",
      "operation": "normalize",
      "raw": "/mnt/cd/repo",
      "options": {
        "sourceHost": "wsl",
        "targetProfile": "portable",
        "wsl": {
          "enabled": true,
