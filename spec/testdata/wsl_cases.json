      },
      "expected": "c:/repo"
    },
    {
      "id": "wsl-mount-prepend-remains-distinct",
      "operation": "normalize",
      "raw": "/mnt/c/repo",
      "options": {
        "wsl": {
          "enabled": true,
          "mountRoot": "/mnt\u0600/"
        }
      },
      "expected": "/mnt/c/repo"
    },
    {
      "id": "wsl-to-mount-prepend-preserved",
      "operation": "to-wsl",
      "raw": "c:/repo",
      "options": {
        "wsl": {
          "enabled": true,
          "mountRoot": "/mnt\u0600///"
        }
      },
      "expected": "/mnt\u0600/c/repo"
