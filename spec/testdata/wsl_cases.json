      "expected": "c:/repo"
    },
    {
      "id": "wsl-identity-unicode-mount-distinct",
      "operation": "normalize",
      "raw": "/café/c/repo",
      "options": {
        "sourceHost": "wsl",
        "targetProfile": "portable",
        "wsl": {
          "enabled": true,
          "mountRoot": "/café"
        }
      },
      "expected": "/café/c/repo"
    },
    {
      "id": "wsl-identity-unicode-mount-distinct-reverse",
      "operation": "normalize",
      "raw": "/café/c/repo",
      "options": {
        "sourceHost": "wsl",
        "targetProfile": "portable",
        "wsl": {
          "enabled": true,
