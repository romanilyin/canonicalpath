        "wsl": {
          "enabled": true,
          "mountRoot": "/drives"
        }
      },
      "expected": "d:/repo"
    },
    {
      "id": "wsl-identity-repeated-separators",
      "operation": "normalize",
      "raw": "/mnt//c//repo/./src/../file",
      "options": {
        "sourceHost": "wsl",
        "targetProfile": "portable",
        "wsl": {
          "enabled": true,
          "mountRoot": "/mnt"
        }
      },
      "expected": "c:/repo/file"
    },
    {
      "id": "wsl-identity-custom-repeated-separators",
      "operation": "normalize",
      "raw": "/mount///x/c/../d/repo",
      "options": {
        "sourceHost": "wsl",
        "targetProfile": "portable",
        "wsl": {
          "enabled": true,
          "mountRoot": "/mount///x///"
        }
      },
      "expected": "d:/repo"
    },
    {
      "id": "wsl-identity-disabled-cross-drive",
      "operation": "normalize",
      "raw": "/mnt/c/../d/repo",
      "options": {
