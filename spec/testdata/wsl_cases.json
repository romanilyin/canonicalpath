    {
      "id": "wsl-reject-removed-ads",
      "operation": "normalize",
      "raw": "/mnt/c/file:stream/../repo",
      "options": {
        "wsl": {
          "enabled": true
        },
        "windows": {
          "rejectADS": true
        }
      },
      "error": "ERR_ALTERNATE_DATA_STREAM"
    },
    {
      "id": "wsl-reject-removed-device",
      "operation": "normalize",
      "raw": "/mnt/c/CON/../repo",
      "options": {
        "wsl": {
          "enabled": true
        },
        "windows": {
          "rejectDeviceNames": true
        }
      },
      "error": "ERR_RESERVED_DEVICE_NAME"
    },
    {
      "id": "wsl-relative-input-never-drive-mapped",
      "operation": "normalize",
      "raw": "drives/c/../d/repo",
      "options": {
        "wsl": {
          "enabled": true,
          "mountRoot": "/drives"
        }
      },
      "expected": "drives/d/repo"
    },
    {
      "id": "wsl-native-drive-never-remapped",
      "operation": "normalize",
      "raw": "c:/d/repo",
      "options": {
        "wsl": {
          "enabled": true,
          "mountRoot": "/mnt"
        }
      },
      "expected": "c:/d/repo"
    },
    {
      "id": "wsl-unicode-letter-not-drive",
      "operation": "normalize",
      "raw": "/mnt/K/repo",
      "options": {
        "wsl": {
          "enabled": true
        }
      },
      "expected": "/mnt/K/repo"
    },
    {
      "id": "wsl-mount-prepend-before-trailing-slash",
      "operation": "normalize",
      "raw": "/mnt\u0600/c/repo",
