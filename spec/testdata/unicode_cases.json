{
  "version": 1,
  "cases": [
    {
      "id": "unicode-preserved-nfc",
      "operation": "normalize",
      "raw": "/repo/caf\u00e9.txt",
      "options": { "sourceHost": "posix", "targetProfile": "posix" },
      "expected": "/repo/caf\u00e9.txt",
      "notes": "MVP preserves Unicode codepoints; it does not fold composed characters."
    },
    {
      "id": "unicode-preserved-nfd",
      "operation": "normalize",
      "raw": "/repo/cafe\u0301.txt",
      "options": { "sourceHost": "posix", "targetProfile": "posix" },
      "expected": "/repo/cafe\u0301.txt",
      "notes": "NFD stays NFD; normalization policy is lexical and does not rewrite Unicode."
    },
    {
      "id": "unicode-uri-decodes-once",
      "operation": "normalize",
      "raw": "file:///repo/caf%C3%A9.txt",
      "options": { "sourceHost": "vscode-file-uri", "targetProfile": "posix", "uri": { "allowFileUri": true } },
      "expected": "/repo/caf\u00e9.txt"
    },
    {
      "id": "unicode-device-check-two-byte",
      "operation": "normalize",
      "raw": "C:/repo/éé.txt",
      "options": {
        "sourceHost": "win32",
        "targetProfile": "win32-drive"
      },
      "expected": "c:/repo/éé.txt"
    },
    {
      "id": "unicode-device-check-four-byte",
      "operation": "normalize",
      "raw": "C:/repo/😀.txt",
      "options": {
        "sourceHost": "win32",
        "targetProfile": "win32-drive"
      },
      "expected": "c:/repo/😀.txt"
    },
    {
      "id": "unicode-device-check-mixed",
      "operation": "normalize",
      "raw": "C:/repo/a€.txt",
      "options": {
        "sourceHost": "win32",
        "targetProfile": "win32-drive"
      },
      "expected": "c:/repo/a€.txt"
    }
  ]
}
