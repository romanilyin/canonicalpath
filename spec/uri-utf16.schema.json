{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "URI inputs represented as exact UTF-16 code units",
  "type": "object",
  "required": [
    "version",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operation",
          "rawUtf16",
          "options"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "operation": {
            "const": "normalize"
          },
          "rawUtf16": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "expected": {
            "type": "string"
          },
          "error": {
            "enum": [
              "ERR_INVALID_PERCENT_ENCODING"
            ]
          },
          "options": {
            "const": {
              "uri": {
                "allowFileUri": true
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "expected"
            ],
            "not": {
              "required": [
                "error"
              ]
            }
          },
          {
            "required": [
              "error"
            ],
            "not": {
              "required": [
                "expected"
              ]
            }
          }
        ]
      }
    }
  }
}
