# Copy this file to .env and put local publishing credentials there.
# Never commit .env or paste tokens into package metadata.
NPM_TOKEN=
UPM_ORGANIZATION_ID=
UPM_SERVICE_ACCOUNT_KEY_ID=
UPM_SERVICE_ACCOUNT_KEY_SECRET=

# Absolute path to an operator-verified UPM CLI executable used for signing.
UPM_CLI_PATH=
